APP_ENV=development

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny
CORS_ORIGINS=http://localhost:5173

DEFAULT_LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=embeddinggemma
# Smoke fallback (no Ollama embed model required): OLLAMA_EMBED_MODEL=hash
EMBEDDING_DIM=768

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1

RAG_VECTOR_CANDIDATES=20
RAG_KEYWORD_CANDIDATES=20
RAG_FINAL_CHUNKS=8
RAG_MAX_CHUNKS_PER_EPISODE=3
RAG_FUSION_CONSTANT=60

MAX_USER_MESSAGE_CHARACTERS=12000
MAX_ARTIFACT_CHARACTERS=100000

CORPUS_REPO_URL=https://github.com/ChatPRD/lennys-podcast-transcripts.git
CORPUS_PATH=data/lennys-podcast-transcripts
